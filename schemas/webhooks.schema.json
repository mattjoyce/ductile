{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattjoyce/ductile/schemas/webhooks.schema.json",
  "title": "Ductile Webhooks",
  "description": "Schema for ductile webhooks.yaml — standalone webhook endpoint definitions (directory mode).",
  "type": "object",
  "properties": {
    "webhooks": {
      "oneOf": [
        {
          "type": "array",
          "description": "Flat list of webhook endpoints (compatibility form).",
          "items": {
            "$ref": "config.schema.json#/$defs/WebhookEndpoint"
          }
        },
        {
          "type": "object",
          "description": "Nested list of webhook endpoints (recommended form).",
          "properties": {
            "endpoints": {
              "type": "array",
              "items": {
                "$ref": "config.schema.json#/$defs/WebhookEndpoint"
              }
            }
          },
          "required": ["endpoints"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["webhooks"],
  "additionalProperties": false
}
