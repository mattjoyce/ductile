#!/usr/bin/env bash
set -euo pipefail

# Host-dependent tests skip with the assumption named rather than fail (see
# docs/TESTING.md "Environment requirements for the fast suite"). Say so up front
# when this run will skip some of them.
if [[ "$(id -u)" -eq 0 ]]; then
  echo "==> test-fast: NOTE running as root; internal/vault permission tests will skip."
fi
for dep in bash python3; do
  command -v "$dep" >/dev/null 2>&1 || \
    echo "==> test-fast: NOTE '$dep' not on PATH; plugin-spawn tests that need it will skip."
done

echo "==> test-fast: go test ./..."
go test ./...

echo "==> test-fast: NOTE current suite may fail if a local process occupies internal/api integration test port 127.0.0.1:18080"
