#!/usr/bin/env bash
set -euo pipefail

# Preflight: a few packages couple to the host environment (see docs/TESTING.md
# "Environment requirements for the fast suite"). Warn early rather than fail cryptically.
if [[ "$(id -u)" -eq 0 ]]; then
  echo "==> test-fast: WARNING — running as root; internal/vault chmod-based 'save failure' tests will fail (root bypasses file permissions). Run as a non-root user."
fi
for dep in bash python3; do
  command -v "$dep" >/dev/null 2>&1 || \
    echo "==> test-fast: WARNING — '$dep' not on PATH; internal/e2e and internal/dispatch plugin-spawn tests will fail."
done

echo "==> test-fast: go test ./..."
go test ./...

echo "==> test-fast: NOTE current suite may fail if a local process occupies internal/api integration test port 127.0.0.1:18080"
