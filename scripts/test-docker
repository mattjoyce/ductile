#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FIXTURE="${1:-all}"

echo "==> test-docker: building ductile binary"
(cd "$ROOT_DIR" && go build -o ductile ./cmd/ductile)

if [[ -x "$ROOT_DIR/scripts/test-docker-runner" ]]; then
  exec "$ROOT_DIR/scripts/test-docker-runner" "$FIXTURE"
fi

# Fallback: the runner should always be present and executable. If it is not,
# the harness is misconfigured (e.g. lost +x on checkout) rather than unbuilt.
echo "==> test-docker: ERROR — scripts/test-docker-runner missing or not executable" >&2
echo "==> requested fixture: $FIXTURE" >&2
echo "==> see docs/TESTING.md for the harness design" >&2
exit 1
